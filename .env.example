# Turso database (https://turso.tech)
# Copy this file to .env.local and fill in your own values.
# If either variable is missing, the app falls back to a local SQLite file
# (./data/chess.db), which is fine for development but not for production.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: restrict admin login to specific client IPs (comma-separated).
# When set, login is rejected from any other IP.
# ADMIN_IP_ALLOWLIST=203.0.113.1,198.51.100.2

# Optional: directory for the local SQLite fallback database (default: ./data).
# CHESS_DATA_DIR=./data